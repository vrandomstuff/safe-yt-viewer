		"@types/react-dom": "^19.2.4",
		"drizzle-kit": "1.0.0-rc.4",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "3.9.6",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3"
