' Main thread. Owns everything that is not SceneGraph: the message port, the
' roSGScreen, the roRegistrySection, roFileSystem and roUrlTransfer.
'
' Playback deliberately does NOT live here. It is a SceneGraph Video node inside
' MainScene, which gives us the documented state machine (state / errorCode /
' errorStr) and a retry path without re-implementing a player. The master
' playlist URL is handed to the node as-is: the node fetches it, and because
' /api/m3u8 mints fresh proxy tokens per request, simply setting the content
' again is the retry.
'
' The keyboard is not here either. It was, as a roKeyboardScreen, until that
' component was removed from the firmware in Roku OS 11.5; it is now a
' StandardKeyboardDialog inside MainScene, which is a node in the scene's own
' tree and therefore has nothing to do with the main thread. See the dialogs
' section of components/MainScene.brs.
'
' The only fields crossing the boundary are the two interface fields declared in
' components/MainScene.xml:
'   apiRequest  scene -> main, set by MainScene
'   apiResult   main -> scene, written here

sub Main()
    m = CreateObject("roAssociativeArray")
    m.port = CreateObject("roMessagePort")
    m.pending = invalid
    m.quit = false

    settings = ApiLoadSettings()
    m.baseUrl = settings.baseUrl
    m.allowInsecure = settings.allowInsecure

    m.screen = CreateObject("roSGScreen")
    m.screen.setMessagePort(m.port)
    m.scene = m.screen.CreateScene("MainScene")
    m.screen.show()
    ' Registered AFTER show(). Observing a field on a node that has been created
    ' but not yet started silently never delivers on this firmware, so an
    ' observer set up before show() misses every request the scene makes and the
    ' grid sits on "Loading..." forever with no error anywhere to explain it.
    m.scene.observeField("apiRequest", m.port)

    ' Pushed proactively rather than waiting for the scene to ask, so the scene
    ' never depends on the timing of that observeField call. MainScene treats a
    ' second "ready" as a no-op.
    MainPush(m, MainHandshake(m))

    while not m.quit
        msg = wait(0, m.port)
        MainHandleMessage(m, msg)
    end while
end sub

sub MainHandleMessage(m as Object, msg as Object) as void
    msgType = type(msg)
    if msgType = "roSGScreenEvent" then
        if msg.isScreenClosed() then
            m.quit = true
        end if
    else if msgType = "roSGNodeEvent" then
        MainHandleRequest(m, msg.getData())
    else if msgType = "roUrlEvent" then
        MainHandleUrlEvent(m, msg)
    end if
end sub

sub MainPush(m as Object, payload as Object) as void
    if m.quit then
        return
    end if
    m.scene.apiResult = payload
end sub

sub MainHandleRequest(m as Object, request as Object) as void
    if Type(request) <> "roAssociativeArray" then
        return
    end if
    if not request.DoesExist("type") then
        return
    end if
    kind = request.type
    if kind = "ready" then
        MainPush(m, MainHandshake(m))
    else if kind = "loadPage" then
        MainLoadPage(m, request)
    else if kind = "play" then
        MainStartPlayback(m, request)
    else if kind = "saveServer" then
        MainSaveServer(m, request)
    end if
end sub

' The scene cannot read config.bs, so everything it needs to know about paging
' and the current server arrives with the handshake.
function MainHandshake(m as Object) as Object
    return {
        type: "ready",
        baseUrl: m.baseUrl,
        allowInsecure: m.allowInsecure,
        defaultBaseUrl: DEFAULT_BASE_URL,
        pageSize: PAGE_SIZE,
        pageLookahead: PAGE_LOOKAHEAD
    }
end function

' ------------------------------------------------------------------ pages

sub MainLoadPage(m as Object, request as Object) as void
    reply = {
        type: "page",
        mode: ApiString(request.mode),
        page: 1,
        reqId: 0,
        ok: false,
        status: 0,
        reason: "",
        ' CreateObject, not []: BrighterScript does not transpile array literals,
        ' so a [] anywhere in here reaches the device as-is and the VM rejects
        ' the file with a parse error. `true` = growable, which matters because
        ' items are appended to below.
        items: CreateObject("roArray", 0, true)
    }
    if request.DoesExist("reqId") then
        reply.reqId = request.reqId
    end if
    if request.DoesExist("page") then
        reply.page = StrToI(ApiString(request.page))
    end if
    if reply.page < 1 then
        reply.reason = "invalid_request"
        MainPush(m, reply)
        return
    end if

    ' One transfer at a time: roUrlTransfer on the main thread has a single
    ' in-flight slot, and the scene guards against overlapping requests anyway.
    if m.pending <> invalid then
        reply.reason = "busy"
        MainPush(m, reply)
        return
    end if

    transfer = ApiBuildTransfer(m, true)
    if transfer = invalid then
        reply.reason = "no_transfer"
        MainPush(m, reply)
        return
    end if

    query = ""
    if request.DoesExist("query") then
        query = ApiString(request.query)
    end if
    ' Hold onto the transfer. If the last reference to an roUrlTransfer goes away
    ' while a request is in flight, the VM collects it and the request dies with
    ' getResponseCode() = -10001 / getFailureReason() = "Cancelled" - which looks
    ' exactly like the server hanging up. Storing it in m.pending is what keeps
    ' it alive until the reply arrives.
    m.pending = { reply: reply, transfer: transfer }
    transfer.setUrl(ApiListUrl(m, reply.mode, reply.page, query))
    if not transfer.AsyncGetToString() then
        m.pending = invalid
        reply.reason = "transfer_failed"
        MainPush(m, reply)
    end if
end sub

sub MainHandleUrlEvent(m as Object, msg as Object) as void
    ' No identity check: the page transfer is the only one with a message port,
    ' and MainLoadPage refuses to start a second while one is in flight.
    if m.pending = invalid then
        return
    end if

    reply = m.pending.reply
    m.pending = invalid
    reply.status = msg.getResponseCode()
    ' roUrlEvent has no isRequestSucceeded() and no isTransferComplete(); calling
    ' either is a runtime error (&hf4), not a false. The whole success test is
    ' GetInt() = 1 (transfer complete) plus a 2xx response code. GetResponseCode()
    ' is negative for transport-level failures, which the 2xx range excludes
    ' anyway.
    body = ""
    if msg.getInt() = 1 and reply.status >= 200 and reply.status < 300 then
        body = msg.getString()
    else
        ' A 4xx/5xx lands here too, not just a transport failure: the body is
        ' empty for those, so there is nothing worth parsing and getFailureReason()
        ' is the only explanation available. That is why there is no separate
        ' "http_error" branch - the 2xx test above already covers it.
        reply.reason = "transfer_failed"
        reply.detail = msg.getFailureReason()
        print "page load failed: status=" ; reply.status ; " reason=" ; reply.detail
        MainPush(m, reply)
        return
    end if

    parsed = ApiParseList(body)
    if not parsed.ok then
        reply.reason = parsed.reason
        MainPush(m, reply)
        return
    end if
    reply.ok = true
    reply.items = parsed.items
    MainPush(m, reply)
end sub

' ------------------------------------------------------------------ play

' One request per selection does two things: it records the watch, and it hands
' back the master playlist URL. Keeping them together is deliberate - the watch
' route is NOT idempotent (every POST inserts a watchData row), so it must fire
' exactly once per selection while the scene may still make several playback
' attempts against the same URL.
sub MainStartPlayback(m as Object, request as Object) as void
    videoId = ""
    if request.DoesExist("videoId") then
        videoId = ApiString(request.videoId)
    end if
    if videoId = "" then
        MainPush(m, { type: "playFailed", videoId: "", reason: "invalid_request" })
        return
    end if
    MainRecordWatch(m, videoId)
    MainPush(m, {
        type: "play",
        videoId: videoId,
        playlistUrl: ApiPlaylistUrl(m, videoId),
        playbackAttempts: PLAYBACK_ATTEMPTS
    })
end sub

' Fire and forget. Nothing consumes the response, and the identity check in
' MainHandleUrlEvent keeps it from being mistaken for a page result.
sub MainRecordWatch(m as Object, videoId as String) as void
    transfer = ApiBuildTransfer(m, false)
    if transfer = invalid then
        return
    end if
    transfer.setUrl(ApiWatchUrl(m, videoId))
    transfer.setRequest("")
    if not transfer.AsyncPostFromString("") then
        print "watch POST could not start for "; videoId
    end if
end sub

' ---------------------------------------------------------------- settings

sub MainSaveServer(m as Object, request as Object) as void
    url = ""
    if request.DoesExist("url") then
        url = request.url
    end if
    m.baseUrl = ApiNormalizeBaseUrl(url)
    insecure = false
    if request.DoesExist("allowInsecure") then
        insecure = request.allowInsecure
    end if
    m.allowInsecure = ApiIsTrue(insecure)
    ApiSaveSettings(m)
    MainPush(m, {
        type: "server",
        baseUrl: m.baseUrl,
        allowInsecure: m.allowInsecure,
        defaultBaseUrl: DEFAULT_BASE_URL
    })
end sub
