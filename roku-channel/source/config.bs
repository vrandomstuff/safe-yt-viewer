' Compile-time configuration for the main thread. Everything in this file is
' part of main.brs's scope, which means component scripts CANNOT see it - the
' MainScene gets the values it needs from the handshake message in main.bs
' rather than duplicating them.

' Server to use until something is saved in the registry. Plain HTTP on purpose:
' the Roku media stack validates TLS against the system trust store only and
' offers no way to install a private CA, so an HTTPS base URL only works for
' the API calls, never for playback. See README.md.
const DEFAULT_BASE_URL = "http://192.168.0.188:3000"

' A CA bundle (PEM) covering the LAN certificate, dropped in by the developer.
' When it is absent we fall back to the Roku system bundle, and when the user
' explicitly opts into insecure mode we drop peer/host verification instead.
const LAN_CA_PATH = "pkg:/certs/lan-ca.pem"
const SYSTEM_CA_PATH = "common:/certs/ca-bundle.crt"

' roRegistrySection names. The registry is per developer ID and survives
' reboots; a reinstall wipes it.
const REGISTRY_SECTION = "safe_yt"
const KEY_BASE_URL = "base_url"
const KEY_INSECURE = "allow_insecure"

' Every list route returns 50 rows per page. Ask for the next page once the user
' gets within PAGE_LOOKAHEAD items of the end of what we already hold.
const PAGE_SIZE = 50
const PAGE_LOOKAHEAD = 15

' /api/m3u8 treats resolution as a ceiling, so ask for the tallest variant and
' let the player switch down on its own. It is also the only route that spawns
' yt-dlp, so it is deliberately NOT prebuffered on focus changes.
const PLAYBACK_RESOLUTION = "1080"

' A proxy URL goes stale (the signed googlevideo URL inside it expires), and the
' player never retries. One extra attempt, which re-GETs the master playlist
' and therefore mints fresh proxy tokens, covers the routine case.
const PLAYBACK_ATTEMPTS = 2

const MODE_VIDEOS = "videos"
const MODE_PINS = "pins"
const MODE_SEARCH = "search"

' The scene cannot see this scope, so every one of these is re-sent to
' MainScene in the "ready" handshake from main.bs rather than being duplicated
' as a constant in the component script.
