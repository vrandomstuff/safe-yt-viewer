{
    "name": "safe-yt-roku",
    "version": "1.0.0",
    "description": "Roku channel for the safe-yt-viewer API",
    "license": "AGPL-3.0",
    "author": "",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "build": "npx brighterscript --rootDir .",
        "check": "npx brighterscript --rootDir . --createPackage false --diagnostic-level hint",
        "watch": "npx brighterscript --rootDir . --watch",
        "deploy": "npx brighterscript --rootDir . --deploy"
    },
    "ropm": {
        "rootDir": "./"
    },
    "devDependencies": {
        "brighterscript": "^0.73.5",
        "ropm": "^0.11.11"
    }
}
